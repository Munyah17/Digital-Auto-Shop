# Copy to backend/.env on the machine that runs node backend/server.js.
# Do not commit backend/.env. Passwords and keys stay on the server.

SMTP_HOST=c3.my-control-panel.com
SMTP_PORT=465
SMTP_USER=info@globalspaceweb.co.zw
SMTP_PASS=
MAIL_FROM=Digital Auto Shop <info@globalspaceweb.co.zw>
MAIL_TO=info@globalspaceweb.co.zw
POP3_HOST=c3.my-control-panel.com
POP3_PORT=995

# Public site URL used for Paynow return/webhook URLs (no trailing slash)
PUBLIC_BASE_URL=https://your-domain.com

# Auth secrets — set real values in production
AUTH_SECRET=
ADMIN_USER=admin
ADMIN_PASS=
VENDOR_PASS=

# Paynow Zimbabwe
PAYNOW_ID=
PAYNOW_KEY=
